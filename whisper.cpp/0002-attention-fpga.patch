+// whisper_fpga_attn.h
+//
+// Ejecuta SOLO la self-attention del encoder en la FPGA (Alveo U55C), a partir
+// de las proyecciones Qcur/Kcur/Vcur que calcula ggml en CPU. Sirve para validar
+// end-to-end (por la transcripción) que la atención en half + dot Q·K en punto
+// fijo mantiene la precisión.
+//
+// Se engancha en el grafo con ggml_map_custom3(Qcur, Kcur, Vcur, ...): las tres
+// entradas llegan contiguas [n_state, n_ctx] (data[t*n_state + canal]) y la
+// salida sale en el mismo layout, que es justo lo que espera la proyección.
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct whisper_fpga_attn;
+
+// Carga el xclbin de atención (kernel attention_top) y prepara el kernel.
+// Devuelve nullptr si falla.
+struct whisper_fpga_attn * whisper_fpga_attn_init(const char * xclbin_path);
+
+// Corre la atención de UNA capa del encoder en la FPGA.
+//   q,k,v : F32 contiguos [n_state, n_ctx], data[t*n_state + canal]  (Qcur/Kcur/Vcur)
+//   out   : F32 contiguo   [n_state, n_ctx], data[t*n_state + head*64 + d]
+//   n_head: 6 (tiny) o 12 (small). El escalado 1/sqrt(64) lo aplica el kernel.
+void whisper_fpga_attn_run(struct whisper_fpga_attn * c,
+                           const float * q, const float * k, const float * v,
+                           int n_head, int n_ctx, int n_state, float * out);
+
+void whisper_fpga_attn_free(struct whisper_fpga_attn * c);
+
+#ifdef __cplusplus
+}
+#endif
