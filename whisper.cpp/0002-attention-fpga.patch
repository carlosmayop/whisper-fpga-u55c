index 00000000..ba119a96
--- /dev/null
+++ b/src/whisper_fpga_attn.cpp
@@ -0,0 +1,205 @@
+// whisper_fpga_attn.cpp — ver whisper_fpga_attn.h
+//
+// Layout que espera el kernel (qkv_tile_loader en multi_head_att.cpp):
+//   qkv_in[ tile*QKV_CHANNELS*BLOCK + canal*BLOCK + frame_in_tile ]
+//   canal: [0, n_state)=Q, [n_state, 2n_state)=K, [2n_state, 3n_state)=V
+//   para la cabeza h: Q en canal h*64, K en n_state+h*64, V en 2n_state+h*64
+//   BLOCK=32, TILES=47, FRAMES=1504 (n_ctx=1500 rellenado con 0 hasta 1504).
+//
+// Los 6 bancos qkv contienen la MISMA qkv completa (cada cabeza lee su rango de
+// canales). La salida son 6 bancos mha compactos [FRAMES][64] por cabeza.
+// small (12 cabezas) = 2 pasadas de 6 cabezas con el arg escalar head_base=0,6;
+// hay que leer mha ENTRE pasadas porque los 6 bancos de salida se reescriben.
+
+#include "whisper_fpga_attn.h"
+
+#include <xrt/xrt_device.h>
+#include <xrt/xrt_kernel.h>
+#include <xrt/xrt_bo.h>
+
+#include <vector>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <chrono>
+
+static const int BLOCK  = 32;
+static const int TILES  = 47;
+static const int FRAMES = 1504;   // 47*32
+static const int D_HEAD = 64;
+
+// --- Perfil: desglose kernel puro vs overhead de host (ensamblado+DMA) ---
+static double g_t_assembly = 0.0;   // f32->half + memcpy a 6 bancos
+static double g_t_upload    = 0.0;   // sync qkv TO_DEVICE
+static double g_t_kernel    = 0.0;   // run.start/wait
+static double g_t_readback  = 0.0;   // sync mha FROM_DEVICE + deconcat
+static long   g_passes      = 0;     // nº de invocaciones de kernel (pasadas de 6 cabezas)
+static long   g_calls       = 0;     // nº de llamadas whisper_fpga_attn_run (capas)
+
+static void whisper_fpga_attn_print_profile() {
+    if (g_calls == 0) return;
+    const double host = g_t_assembly + g_t_upload + g_t_readback;
+    fprintf(stderr,
+        "\n[fpga-attn PERFIL] %ld llamadas (capas), %ld pasadas de kernel\n"
+        "  kernel HW puro : %8.1f ms  (%.2f ms/pasada)\n"
+        "  ensamblado     : %8.1f ms  (f32->half + copia a 6 bancos)\n"
+        "  upload qkv     : %8.1f ms\n"
+        "  readback+decon : %8.1f ms\n"
+        "  --> host total : %8.1f ms   |   kernel %.0f%%, host %.0f%% del tiempo FPGA\n",
+        g_calls, g_passes,
+        g_t_kernel, g_passes ? g_t_kernel / g_passes : 0.0,
+        g_t_assembly, g_t_upload, g_t_readback, host,
+        100.0 * g_t_kernel / (g_t_kernel + host),
+        100.0 * host       / (g_t_kernel + host));
+}
+
+using clk = std::chrono::high_resolution_clock;
+static inline double ms_since(const clk::time_point & a) {
+    return std::chrono::duration<double, std::milli>(clk::now() - a).count();
+}
+
+// ---- conversiones F32 <-> FP16 (IEEE half) en software -------------------
+static inline uint16_t f32_to_f16(float f) {
+    uint32_t x; std::memcpy(&x, &f, 4);
+    uint32_t sign = (x >> 16) & 0x8000u;
+    int32_t  exp  = (int32_t)((x >> 23) & 0xFF) - 127 + 15;
+    uint32_t man  = x & 0x7FFFFFu;
+    if (((x >> 23) & 0xFF) == 0xFF) {              // Inf / NaN
+        return (uint16_t)(sign | 0x7C00u | (man ? 0x200u : 0));
+    }
+    if (exp >= 0x1F) return (uint16_t)(sign | 0x7C00u);     // overflow -> Inf
+    if (exp <= 0) {                                          // subnormal / cero
+        if (exp < -10) return (uint16_t)sign;
+        man |= 0x800000u;
+        uint32_t shift = (uint32_t)(14 - exp);
+        uint32_t h = man >> shift;
+        if ((man >> (shift - 1)) & 1) h += 1;               // redondeo
+        return (uint16_t)(sign | h);
+    }
+    uint16_t h = (uint16_t)(sign | ((uint32_t)exp << 10) | (man >> 13));
+    if (man & 0x1000u) h += 1;                              // redondeo al par
+    return h;
+}
+
+static inline float f16_to_f32(uint16_t h) {
+    uint32_t sign = (uint32_t)(h & 0x8000u) << 16;
+    uint32_t exp  = (h >> 10) & 0x1F;
+    uint32_t man  = h & 0x3FFu;
+    uint32_t out;
+    if (exp == 0) {
+        if (man == 0) { out = sign; }
+        else {                                              // subnormal
+            exp = 127 - 15 + 1;
+            while ((man & 0x400u) == 0) { man <<= 1; exp--; }
+            man &= 0x3FFu;
+            out = sign | (exp << 23) | (man << 13);
+        }
+    } else if (exp == 0x1F) {
+        out = sign | 0x7F800000u | (man << 13);             // Inf / NaN
+    } else {
+        out = sign | ((exp - 15 + 127) << 23) | (man << 13);
+    }
+    float f; std::memcpy(&f, &out, 4);
+    return f;
+}
+
+struct whisper_fpga_attn {
+    xrt::device device;
+    xrt::kernel krnl;
+    xrt::run    run;
+    std::vector<xrt::bo> qkv;   // 6 bancos entrada (qkv completa, idéntica)
+    std::vector<xrt::bo> mha;   // 6 bancos salida (compacto por cabeza)
+    int n_state = 0;            // 0 = buffers aún no reservados
+};
+
+struct whisper_fpga_attn * whisper_fpga_attn_init(const char * xclbin_path) {
+    try {
+        auto * c = new whisper_fpga_attn();
+        c->device = xrt::device(0);
+        auto uuid = c->device.load_xclbin(xclbin_path);
+        c->krnl   = xrt::kernel(c->device, uuid, "attention_top");
+        c->run    = xrt::run(c->krnl);
+        fprintf(stderr, "[fpga-attn] xclbin cargado: %s\n", xclbin_path);
+        atexit(whisper_fpga_attn_print_profile);   // desglose al salir
+        return c;
+    } catch (const std::exception & e) {
+        fprintf(stderr, "[fpga-attn] init FALLÓ: %s\n", e.what());
+        return nullptr;
+    }
+}
+
+static void alloc_buffers(whisper_fpga_attn * c, int n_state) {
+    const int    QKV_CH    = n_state * 3;
+    const size_t qkv_bytes = (size_t)FRAMES * QKV_CH * 2;
+    const size_t mha_bytes = (size_t)FRAMES * D_HEAD * 2;
+    c->qkv.clear(); c->mha.clear();
+    for (int i = 0; i < 6; i++) c->qkv.push_back(xrt::bo(c->device, qkv_bytes, c->krnl.group_id(i)));
+    for (int i = 0; i < 6; i++) c->mha.push_back(xrt::bo(c->device, mha_bytes, c->krnl.group_id(6 + i)));
+    for (int i = 0; i < 6; i++) c->run.set_arg(i,     c->qkv[i]);
+    for (int i = 0; i < 6; i++) c->run.set_arg(6 + i, c->mha[i]);
+    c->n_state = n_state;
+    fprintf(stderr, "[fpga-attn] buffers reservados (n_state=%d, %.1f MB/banco qkv)\n",
+            n_state, qkv_bytes / 1e6);
+}
+
+void whisper_fpga_attn_run(whisper_fpga_attn * c,
+                           const float * q, const float * k, const float * v,
+                           int n_head, int n_ctx, int n_state, float * out) {
+    if (c->n_state != n_state) alloc_buffers(c, n_state);
+
+    const int QKV_CH = n_state * 3;
+    g_calls++;
+
+    // --- Ensamblar qkv en el layout FA (una vez) en el banco 0 ---
+    auto t_asm = clk::now();
+    uint16_t * dst0 = c->qkv[0].map<uint16_t*>();
+    for (int t = 0; t < TILES; t++) {
+        for (int ch = 0; ch < QKV_CH; ch++) {
+            const float * src; int src_ch;
+            if      (ch < n_state)     { src = q; src_ch = ch; }
+            else if (ch < 2 * n_state) { src = k; src_ch = ch - n_state; }
+            else                       { src = v; src_ch = ch - 2 * n_state; }
+            const int base = t * QKV_CH * BLOCK + ch * BLOCK;
+            for (int fit = 0; fit < BLOCK; fit++) {
+                const int f = t * BLOCK + fit;
+                float val = (f < n_ctx) ? src[(size_t)f * n_state + src_ch] : 0.0f;
+                dst0[base + fit] = f32_to_f16(val);
+            }
+        }
+    }
+    // Copiar la misma qkv a los otros 5 bancos.
+    const size_t qkv_elems = (size_t)FRAMES * QKV_CH;
+    for (int i = 1; i < 6; i++)
+        std::memcpy(c->qkv[i].map<uint16_t*>(), dst0, qkv_elems * 2);
+    g_t_assembly += ms_since(t_asm);
+
+    auto t_up = clk::now();
+    for (int i = 0; i < 6; i++) c->qkv[i].sync(XCL_BO_SYNC_BO_TO_DEVICE);
+    g_t_upload += ms_since(t_up);
+
+    // --- Pasadas de 6 cabezas (tiny=1, small=2). Leer mha ENTRE pasadas. ---
+    const int passes = n_head / 6;
+    for (int p = 0; p < passes; p++) {
+        if (n_head > 6) c->run.set_arg(12, p * 6);   // head_base (solo kernel small)
+        auto t_k = clk::now();
+        c->run.start();
+        c->run.wait();
+        g_t_kernel += ms_since(t_k);
+        g_passes++;
+        auto t_rb = clk::now();
+        for (int i = 0; i < 6; i++) c->mha[i].sync(XCL_BO_SYNC_BO_FROM_DEVICE);
+        for (int lh = 0; lh < 6; lh++) {
+            const int gh = p * 6 + lh;               // cabeza global
+            const uint16_t * mh = c->mha[lh].map<uint16_t*>();
+            for (int f = 0; f < n_ctx; f++)
+                for (int d = 0; d < D_HEAD; d++)
+                    out[(size_t)f * n_state + gh * D_HEAD + d] = f16_to_f32(mh[(size_t)f * D_HEAD + d]);
+        }
+        g_t_readback += ms_since(t_rb);
+    }
+}
+
+void whisper_fpga_attn_free(whisper_fpga_attn * c) {
+    delete c;
+}
