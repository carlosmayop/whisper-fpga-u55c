diff --git a/ggml/src/ggml-cpu/fpga_backend.cpp b/ggml/src/ggml-cpu/fpga_backend.cpp
new file mode 100644
index 00000000..483515d2
--- /dev/null
+++ b/ggml/src/ggml-cpu/fpga_backend.cpp
@@ -0,0 +1,165 @@
+#include "fpga_backend.h"
+#include <cstring>
+#include <cstdint>
+#include <cmath>
+#include <iostream>
+
+// Definiciones locales para no depender de ggml.h
+typedef uint16_t ggml_half;
+
+// Aseguramos alineación a 1 byte para leer la memoria tal cual está
+#pragma pack(push, 1)
+
+// Layout de memoria idéntico al struct block_q5_1 de GGML
+struct block_q5_1 {
+    ggml_half d;       // delta (2 bytes)
+    ggml_half m;       // min   (2 bytes)
+    uint8_t   qh[4];   // 5-th bit (4 bytes)
+    uint8_t   qs[16];  // nibbles (16 bytes)
+};
+
+// Layout estándar de block_q8_1
+struct block_q8_1 {
+    ggml_half d;       // delta (2 bytes)
+    ggml_half s;       // sum   (2 bytes)
+    int8_t    qs[32];  // quants (32 bytes)
+};
+
+#pragma pack(pop)
+
+// Función estándar IEEE 754 para convertir Half a Float
+// Corrige el error de escala (factor 64) que tenías antes.
+static float fp16_to_fp32(uint16_t h) {
+    uint32_t s = (h >> 15) & 0x1;
+    uint32_t e = (h >> 10) & 0x1F;
+    uint32_t m =  h        & 0x3FF;
+
+    if (e == 0) {
+        if (m == 0) return s ? -0.0f : 0.0f;
+        // Denormalizado (muy raro en pesos, pero por si acaso)
+        // Valor = (-1)^s * (m / 1024) * 2^-14
+        float val = (float)m / 1024.0f;
+        float factor = 6.1035156e-05f; // 2^-14
+        return s ? -val * factor : val * factor;
+    } else if (e == 31) {
+        // Infinito o NaN
+        return 0.0f; // En inferencia solemos preferir 0 a romper el cálculo
+    }
+
+    // Normalizado
+    // Nuevo exponente = e - 15 (bias fp16) + 127 (bias fp32)
+    uint32_t f_e = e - 15 + 127;
+    
+    // Construir float de 32 bits: S | E (8 bits) | M (23 bits)
+    // El mantisa de fp16 (10 bits) se mueve a la izquierda (bits más altos del mantisa fp32)
+    uint32_t f = (s << 31) | (f_e << 23) | (m << 13);
+    
+    float res;
+    memcpy(&res, &f, sizeof(float));
+    return res;
+}
+
+extern "C" {
+    void fpga_init(const char* path) { (void)path; }
+
+    // Implementación exacta de ggml_vec_dot_q5_1_q8_1
+    void fpga_vec_dot_q5_1_q8_1(int n, float* dst, const void* src0, const void* src1) {
+        static bool first_call = true; 
+        
+        const block_q5_1* x = (const block_q5_1*) src0;
+        const block_q8_1* y = (const block_q8_1*) src1;
+
+        if (first_call) { 
+            std::cout << "FPGA backend: ggml_vec_dot_q5_1_q8_1 called with n = " << n << "\n"; 
+            std::cout << "BLOCK Q5_1: d = " << fp16_to_fp32(x[0].d) << ", m = " << fp16_to_fp32(x[0].m) << ", qh[0] = " << *(uint32_t*)x[0].qh << ", qs[0] = " << (int)x[0].qs[0] << "\n";
+            std::cout << "BLOCK Q8_1: d = " << fp16_to_fp32(y[0].d) << ", s = " << fp16_to_fp32(y[0].s) << ", qs[0] = " << (int)y[0].qs[0] << "\n";
+            first_call = false; 
+        }
+        
+        
+        const int qk = 32;
+        const int nb = n / qk; 
+        
+        double sumf = 0.0;
+
+        for (int i = 0; i < nb; ++i) {
+            // 1. Extraer bits altos (qh)
+            // Usamos memcpy para evitar problemas de alineación/endianness
+            uint32_t qh;
+            memcpy(&qh, x[i].qh, sizeof(qh));
+
+            // 2. Acumuladores para la parte entera
+            int sumi0 = 0;
+            int sumi1 = 0;
+
+            for (int j = 0; j < qk/2; ++j) { // j de 0 a 15
+                // Extraer el bit 5 (high bit) correspondiente
+                // Lógica idéntica a ggml generic:
+                // xh_0: bit para la primera mitad (0-15)
+                const uint8_t xh_0 = ((qh >> j) << 4) & 0x10;
+                
+                // xh_1: bit para la segunda mitad (16-31)
+                // En generic usan: (qh >> (j + 12)) & 0x10
+                const uint8_t xh_1 = ((qh >> (j + 12))) & 0x10;
+
+                // Reconstruir los valores de 5 bits
+                // x0 = nibble bajo + bit alto
+                const int32_t x0 = (x[i].qs[j] & 0xF) | xh_0;
+                
+                // x1 = nibble alto + bit alto
+                const int32_t x1 = (x[i].qs[j] >>  4) | xh_1;
+
+                // Multiplicar por la entrada cuantizada (Q8_1)
+                // y[i].qs tiene 32 bytes firmados
+                sumi0 += (x0 * y[i].qs[j]);
+                sumi1 += (x1 * y[i].qs[j + qk/2]);
+            }
+
+            int sumi = sumi0 + sumi1;
+
+            // 3. Aplicar escalas y sumar al total
+            // Fórmula GGML: (d_x * d_y) * sum_i + (m_x * s_y)
+            
+            float d_x = fp16_to_fp32(x[i].d);
+            float m_x = fp16_to_fp32(x[i].m);
+            float d_y = fp16_to_fp32(y[i].d);
+            float s_y = fp16_to_fp32(y[i].s);
+            
+            sumf += (d_x * d_y) * sumi + (m_x * s_y);
+        }
+        
+        *dst = (float)sumf;
+    }
+
+    // GEMM: General Matrix-Matrix multiplication
+    // n_rows:   Filas de la matriz de pesos (ne01)
+    // n_cols:   Columnas de la matriz de pesos / Tamaño del vector (ne00)
+    // n_tokens: Número de tokens a procesar simultáneamente (ne11)
+    void fpga_gemm_q5_1_q8_1(int n_rows, int n_cols, int n_tokens, float* dst, const void* src0, const void* src1) {
+
+        const size_t weight_row_size = (n_cols / 32) * sizeof(block_q5_1); // Tamaño fila pesos
+        const size_t input_row_size  = (n_cols / 32) * sizeof(block_q8_1); // Tamaño fila input (Q8_1)
+        
+        const char* w_ptr = (const char*)src0;
+
+
+        for (int i = 0; i < n_rows; ++i) {
+            
+            // Para esta fila de pesos 'i', calculamos el producto escalar contra TODOS los tokens
+            for (int t = 0; t < n_tokens; ++t) {
+                
+                // Puntero al vector del token 't'
+                const char* x_ptr = (const char*)src1 + (t * input_row_size);
+                
+                
+                float* res_ptr = &dst[t * n_rows + i];
+
+                // Llamamos a la función vectorial (que la FPGA haría en paralelo hardware)
+                fpga_vec_dot_q5_1_q8_1(n_cols, res_ptr, w_ptr, x_ptr);
+            }
+
+            // Avanzamos el puntero de pesos una sola vez por fila
+            w_ptr += weight_row_size;
+        }
+    }
+}
